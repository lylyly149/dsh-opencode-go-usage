{
  "name": "@lylyly149/dsh-opencode-go-usage",
  "version": "1.1.0",
  "description": "OpenCode Go plan usage for DeepSeek Harness: a 270° composer fan and a Settings page for the rolling, weekly, and monthly quota windows.",
  "license": "MIT",
  "author": "lylyly149",
  "type": "module",
  "main": "./index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs/*.png"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "opencode",
    "opencode-go",
    "usage",
    "quota",
    "plugin",
    "cordis"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lylyly149/dsh-opencode-go-usage.git"
  },
  "homepage": "https://github.com/lylyly149/dsh-opencode-go-usage#readme",
  "bugs": {
    "url": "https://github.com/lylyly149/dsh-opencode-go-usage/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
